# Database (Render: Supabase, Vercel: Neon)
DATABASE_URL=
# Migration için doğrudan (pooler olmayan) bağlantı
DATABASE_URL_UNPOOLED=

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Müşteri cihaz imzası — en az 32 rastgele bayt (openssl rand -base64 32)
CUSTOMER_DEVICE_HMAC_SECRET=

# iyzico (abonelik ödemesi) — sandbox: https://sandbox-api.iyzipay.com, canlı: https://api.iyzipay.com
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_MERCHANT_ID=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
# Opsiyonel: iyzico:setup-plans tekrar çalıştırıldığında aynı ürünü kullanmak için
IYZICO_PRODUCT_REF=

# Kişisel veri saklama işi (src/lib/services/data-retention.service.ts). Varsayılan: kapalı.
#   dry-run → silinecek kayıt sayılarını loglar, hiçbir şey değiştirmez
#   apply   → ayda bir siler ve anonimleştirir. Geri alınamaz: önce dry-run çıktısına bakın
# DATA_RETENTION_MODE=dry-run
